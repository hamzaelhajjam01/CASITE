# Server Port & Core Settings
PORT=3001
CORS_ORIGIN=https://polarguardinsurance.com

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=polarguard

# Authentication & JWT
JWT_SECRET=dev_secret_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@polarguardinsurance.com
# Generate password hash with: node -e "const b=require('bcryptjs');console.log(b.hashSync('yourpassword',12))"
ADMIN_PASSWORD_HASH=

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Provider API Keys
GEMINI_API_KEY=
XAI_API_KEY=

# Outgoing Mail (SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@polarguardinsurance.com
SMTP_PASS=
FROM_NAME="PolarGuard Customer Operations"
FROM_EMAIL=contact@polarguardinsurance.com

# Incoming Mail (IMAP)
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=contact@polarguardinsurance.com
IMAP_PASS=
